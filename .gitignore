# ── Python ────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Virtual environments ──────────────────────────────
.venv/
venv/
env/

# ── PHANTOM runtime / local data ──────────────────────
# Client reports and scan logs are CONFIDENTIAL — never commit them.
# Ignore everything directly under reports/ EXCEPT the demo samples/ subtree.
reports/*
!reports/samples/
graphify-out/

# Local machine-specific launcher (generated by install.sh)
phantom.desktop

# Assessment run logs (may contain scan output)
assessment_run*.log

# ── Editor / OS noise ─────────────────────────────────
.DS_Store
*.swp
.idea/
.vscode/

# Local Claude Code settings (machine-specific)
.claude/settings.local.json
