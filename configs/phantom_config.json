{
  "version": "2.0",
  "project_name": "PHANTOM Framework",
  "workspace_path": "~/PHANTOM_WORKSPACE",
  "database": {
    "path": "~/.phantom/scans.db",
    "type": "sqlite3"
  },
  "ai": {
    "engine": "llama",
    "model": "llama2",
    "host": "127.0.0.1",
    "port": 11434,
    "enabled": true
  },
  "agent": {
    "enabled": true,
    "auto_phase_advance": true,
    "guidance_level": "detailed",
    "save_workflows": true
  },
  "logging": {
    "path": "~/.phantom_logs",
    "level": "INFO"
  },
  "reports": {
    "path": "~/.phantom/reports"
  },
  "tools": {
      "recon": [
          "whois",
          "nslookup",
          "dig",
          "theHarvester",
          "traceroute",
          "host",
          "recon-ng",
          "sherlock"
      ],
      "dns_enum": [
          "dnsenum",
          "dnsrecon",
          "sublist3r"
      ],
      "scanning": [
          "nmap",
          "nikto",
          "dirb",
          "gobuster",
          "masscan",
          "arp-scan",
          "enum4linux",
          "snmp-check",
          "onesixtyone",
          "legion"
      ],
      "webapp": [
          "sqlmap",
          "wapiti",
          "whatweb",
          "curl",
          "burpsuite",
          "wpscan"
      ],
      "passwords": [
          "hydra",
          "john",
          "hashcat"
      ],
      "exploitation": [
          "metasploit",
          "msfvenom",
          "searchsploit",
          "mimikatz",
          "bloodhound",
          "linpeas",
          "winpeas",
          "responder"
      ],
      "post_exploit": [
          "mimikatz",
          "bloodhound",
          "linpeas",
          "winpeas",
          "responder"
      ],
      "reporting": [
          "cherrytree",
          "dradis"
      ],
      "network": [
          "wireshark",
          "tcpdump",
          "arpspoof",
          "ettercap"
      ]
  }
}